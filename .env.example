# Copiar este archivo a ".env" y completar los valores reales.
# ".env" nunca se sube a git (ver .gitignore) porque contiene secretos.

# Puerto donde corre la API (start-project.ps1 expone este puerto en Docker).
PORT=9090

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=arkivy

# Zitadel (proveedor de autenticación) — ver https://console.zitadel.dev
# Dominio de la instancia de Zitadel (Cloud o self-hosted), sin slash final.
ZITADEL_DOMAIN=https://your-instance.zitadel.cloud
# Client ID de la aplicación registrada en Zitadel.
ZITADEL_CLIENT_ID=
# Ruta al archivo de la service account key descargado desde Zitadel (JSON).
ZITADEL_KEY_PATH=key.json
# Token de la service account, usado para llamar a la API de administración de Zitadel.
ZITADEL_SERVICE_TOKEN=
# ID del proyecto de Zitadel donde viven los roles (collaborator, invited, plat-admin, sys-admin).
ZITADEL_PROJECT_ID=
# ID del Identity Provider de Google configurado en Zitadel (login social). Vacío = deshabilitado.
ZITADEL_GOOGLE_IDP=
# ID del Identity Provider de GitHub configurado en Zitadel (login social). Vacío = deshabilitado.
ZITADEL_GITHUB_IDP=

# URL del frontend (arkivy-ui) — usada para CORS y para armar las URLs de retorno del login social.
FRONTEND_URL=http://localhost:4200

# ⚠️ SOLO DESARROLLO LOCAL. Si es "true", el backend deja de validar la sesión
# contra Zitadel (SessionMiddleware) y en su lugar autentica siempre a un
# usuario de prueba fijo, sembrado automáticamente en Mongo al arrancar.
# Habilita además POST /auth/dev-login (sin esto no existe esa ruta).
# Nunca poner en "true" fuera de tu máquina.
DEV_AUTH_BYPASS=false
